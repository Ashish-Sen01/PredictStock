# ==============================================================================
# PredictStock — Production .gitignore
# ==============================================================================

# --- Node.js & Frontend Build Outputs ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python & Cache Artifacts ---
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Jupyter Notebook Checkpoints & ML Logs ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*/*/.ipynb_checkpoints/
catboost_info/
*/catboost_info/
*/*/*/events.out.tfevents*

# --- Large Datasets (> 25MB - Exceeds GitHub Limits) ---
# Raw transaction files
data/raw/sales.csv
data/raw/discounts_history.csv
data/raw/online.csv
data/raw/price_history.csv

# Large intermediate processed parquets
data/processed/sales_audited.parquet
data/processed/sales_prepared.parquet
data/processed/daily_panel_corrected.parquet

# --- Keep Essential App Runtime Data ---
!data/processed/final_demand_forecast.parquet
!data/processed/final_inventory_recommendation.parquet
!data/processed/final_inventory_recommendation.csv
!data/raw/catalog.csv
!data/raw/stores.csv
!data/raw/actual_matrix.csv
!data/raw/markdowns.csv

# --- Operating System & IDE Files ---
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
